<script type='text/javascript' src='http://50.248.15.145:8001/jsv/SncViewer.js'></script>
</head>
<body bgcolor="#FFFFFF" leftmargin="0" topmargin="0" marginwidth="0" marginheight="0" onLoad="new SNC.viewer('MyViewer', {sz:'4',at:'1',fps:'15',mt:'1',vo:'0',iSM:'0',iFPS:'0',iPS:'1',iVO:'0',iIST:'0'})">
	<cfquery name="qCameras" datasource="#application.dsource#">
		SELECT * from camera
		WHERE camera_name = 'front'
	</cfquery>
<table id="Table_01" width="100%" height="100%" border="0" cellpadding="0" cellspacing="0">
	<tr>
		<td colspan="2" width="100%" height="125" valign="top" bgcolor="#000000">
			<cfinclude template="top.cfm">
		</td>
	</tr>
	<tr>
		<td colspan="2" width="100%" valign="top" height="37" bgcolor="#000000">
			<cfinclude template="navbar.cfm">
		</td>
	</tr>
	<tr height="100%">
		<td valign="top" height="1000" colspan="2">
			<table>
				<tr>
					<td>
						<div style="background-image: url(http://www.coolstrokes.com/gallery-art/camera-area-screen21.jpg); background-repeat: no-repeat; width: 873px; border: 2px; padding-top: 5px; height: 500px; position: relative; font-size: 15px; ">
  							<div style='margin:50px' id='MyViewer'></div>
						</div>
						<div style="width: 654px; padding-left: 36px; color: #000000; font-size: 11pt; z-index: -1;">
							<hr>
							<div style="width:650px;">
								<H1 style="font-size: 29px; font-weight: bold; font-family: initial;">Quick Video Tutorial: <em>How To Control The Camera</em></H1>
								<iframe width="640" height="365" src="https://www.youtube.com/embed/4Hnpz21NUow?rel=0&amp;showinfo=0" frameborder="1" allowfullscreen></iframe>
							</div>
							<br></br>
							<hr>
							<div>
								<H1 style="font-size: 29px; font-weight: bold; font-family: initial;">Quick Instructions: <em>How To Control The Camera</em></H1>
								<img src="cameras/images/cam-instructions-v2.jpg" alt="Camera Instructions" align="middle">
								<br></br>
							</div>
							<br/><br/>
							<img src="cameras/images/preset-camera-angles.jpg" border="0">
							<br/><br />
							<span style="color: #fc56fc;">FRONT LIVE CAM PRE-SET VIEW KEY</span>
							<table width="350" border="1" cellpadding="3" cellspacing="0" style="color: #333333; border-color: #999999">

								<cfoutput query="qCameras">
									<tr>
										<td style="width: 10%" align="center">#camera_number#</td>
										<td style="padding-left:10px;">#location#</td>
									</tr>
								</cfoutput>
							</table>
							<br /><br />
						</div>
					</td>
				</tr>
			</table>
		</td>
	</tr>
	<tr>
		<td colspan="2" valign="baseline">
			<cfinclude template="footer.cfm">
		</td>
		
	</tr>
</table>

<cfinclude template="frmxss.cfm">

</body>
</html>